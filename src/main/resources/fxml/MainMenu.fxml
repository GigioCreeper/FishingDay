<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<!-- The title is part of menuBackground.png; layout and look are defined in MainMenu.css. -->
<StackPane prefHeight="720.0" prefWidth="1280.0"
           stylesheets="@../css/MainMenu.css, @../css/Story.css"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg129382.view.menu.MainMenuController">

    <VBox alignment="TOP_CENTER" styleClass="main-menu">
        <Button fx:id="continueButton" mnemonicParsing="false" onAction="#onContinueButtonClicked"
                styleClass="main-button" text="Continue"/>
        <Button mnemonicParsing="false" onAction="#onNewGameButtonClicked" styleClass="main-button" text="New Game"/>
        <Button mnemonicParsing="false" onAction="#onExitButtonClicked" styleClass="main-button, exit-button"
                text="Exit"/>
    </VBox>

    <StackPane fx:id="confirmOverlay" visible="false" styleClass="dialog-overlay">
        <VBox styleClass="story-panel" maxWidth="600" maxHeight="-Infinity">
            <Label styleClass="story-title" text="New Game"/>
            <Label styleClass="story-text" wrapText="true"
                   text="Your saved game will be lost. Start a new game?"/>
            <HBox alignment="CENTER" spacing="18">
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancelNewGame"
                        styleClass="main-button" text="Cancel"/>
                <Button mnemonicParsing="false" onAction="#onConfirmNewGame"
                        styleClass="main-button, exit-button" text="Start"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>