<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Reuses the wooden buttons and the pixel font from MainMenu.css; Shop.css adds the shop look.
     The rod cards are created by ShopController from the rod catalog. -->
<VBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" styleClass="shop"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unicam.cs.mpgc.rpg129382.view.shop.ShopController">
    <stylesheets>
        <URL value="@../css/MainMenu.css"/>
        <URL value="@../css/Shop.css"/>
    </stylesheets>
    <Label styleClass="shop-title" text="Negozio"/>
    <HBox alignment="CENTER" spacing="8">
        <ImageView fx:id="moneyIcon" fitHeight="36" preserveRatio="true"/>
        <Label fx:id="moneyLabel" styleClass="shop-money"/>
    </HBox>
    <Label fx:id="catchLabel" styleClass="shop-label"/>
    <HBox fx:id="rodCardsBox" alignment="CENTER" spacing="28"/>
    <Label fx:id="messageLabel" styleClass="shop-message"/>
    <HBox alignment="CENTER" spacing="24">
        <Button fx:id="sellButton" mnemonicParsing="false" onAction="#onSellClicked" styleClass="main-button" text="Vendi tutto"/>
        <Button mnemonicParsing="false" onAction="#onBackClicked" styleClass="main-button" text="Torna al lago"/>
    </HBox>
</VBox>