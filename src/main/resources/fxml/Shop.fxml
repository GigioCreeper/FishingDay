<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- Reuses the wooden buttons and the pixel font from MainMenu.css; Shop.css adds the shop panel. -->
<VBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" styleClass="shop"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unicam.cs.mpgc.rpg129382.view.shop.ShopController">
    <stylesheets>
        <URL value="@../css/MainMenu.css"/>
        <URL value="@../css/Shop.css"/>
    </stylesheets>
    <Label styleClass="shop-title" text="Negozio"/>
    <Label fx:id="moneyLabel" styleClass="shop-label"/>
    <Label fx:id="catchLabel" styleClass="shop-label"/>
    <Button fx:id="sellButton" mnemonicParsing="false" onAction="#onSellClicked" styleClass="main-button" text="Vendi tutto"/>
    <Label fx:id="rodLabel" styleClass="shop-label"/>
    <Button fx:id="upgradeButton" mnemonicParsing="false" onAction="#onUpgradeClicked" styleClass="main-button"/>
    <Label fx:id="messageLabel" styleClass="shop-message"/>
    <Button mnemonicParsing="false" onAction="#onBackClicked" styleClass="main-button" text="Torna al lago"/>
</VBox>